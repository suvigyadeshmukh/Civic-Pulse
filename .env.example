# ==============================================================================
# Civic Pulse — Environment Configuration Template (.env.example)
# Duplicate this file as .env in the project root: cp .env.example .env
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=true
LOG_LEVEL=info
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# PostgreSQL Database Configuration
# Async engine for FastAPI application runtime (asyncpg)
DATABASE_URL=postgresql+asyncpg://civicpulse:civicpulse_secret@localhost:5432/civicpulse_db
# Synchronous engine for Alembic schema migrations & Celery sync tasks (psycopg2)
SYNC_DATABASE_URL=postgresql+psycopg2://civicpulse:civicpulse_secret@localhost:5432/civicpulse_db

# Docker PostgreSQL Container Defaults
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=civicpulse_secret
POSTGRES_DB=civicpulse_db

# Redis Configuration (Cache, Pub/Sub & Celery Message Broker)
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3 / AWS S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secret
S3_BUCKET_NAME=civicpulse-media
S3_PUBLIC_BASE_URL=http://localhost:9000/civicpulse-media
S3_REGION=us-east-1

# Authentication & Security
# 256-bit secret key for signing JSON Web Tokens
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Personally Identifiable Information (PII) AES-256-GCM Field-Level Encryption
# 32-byte Base64-encoded key: Base64("0123456789abcdef0123456789abcdef")
PII_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# External AI & API Integrations
# Google Gemini API (Multimodal Triage, Document Ingestion, Policy Explainer)
GEMINI_API_KEY=

# OpenAI API (Optional alternative embeddings / LLM fallback)
OPENAI_API_KEY=

# Bhashini Indian Language Translation & Multilingual Voice Synthesis
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Google Fact Check Tools ClaimReview Search API
GOOGLE_FACTCHECK_API_KEY=

# CORS Allowed Origins (JSON Array or Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

