# ==============================================================================
# Civic Pulse — Frontend (Vite) Environment Configuration
# Duplicate this file as `.env` in the client directory: cp .env.example .env
# ==============================================================================

# Base URL for REST calls. The Vite dev server proxies /api -> http://localhost:8000.
VITE_API_BASE_URL=/api/v1

# WebSocket base URL (live agent streams, SLA updates). Proxied via /ws in dev.
VITE_WS_BASE_URL=ws://localhost:8000/ws

# When true, the API layer serves deterministic contract fixtures instead of
# requiring the FastAPI backend to be running.
VITE_USE_API_MOCKS=true
